<?xml version="1.0" encoding="utf-8"?>
<!--
  Pin package restore to nuget.org only. `<clear />` drops any feed inherited from
  a machine-level NuGet.config, so contributors with private company feeds (and CI)
  restore the same packages from the same place.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
