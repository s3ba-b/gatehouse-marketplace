# Copy this file to .env before running `docker compose up` (see README.md "Run
# locally"). docker compose reads .env automatically to fill in the ${...}
# references in docker-compose.yml.

# Same committed, dev-only value as src/Gatehouse.AppHost/appsettings.json's
# "postgres-password" parameter (see AppHost.cs) — never use outside local
# development.
POSTGRES_PASSWORD=insecure-dev-only-do-not-use-in-prod
