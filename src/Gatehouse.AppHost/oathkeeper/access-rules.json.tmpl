[
  {
    "id": "catalog:get-products",
    "version": "v0.40.9",
    "match": {
      "url": "http://<*>/products",
      "methods": ["GET"]
    },
    "authenticators": [
      { "handler": "cookie_session" }
    ],
    "authorizer": {
      "handler": "allow"
    },
    "mutators": [
      { "handler": "id_token" }
    ],
    "upstream": {
      "url": "__CATALOG_UPSTREAM_URL__",
      "preserve_host": false
    }
  }
]
