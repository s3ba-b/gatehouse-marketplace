# Rename to dependabot.yml in the new repo and set `package-ecosystem` to match
# the charter's stack. Examples: "nuget" (.NET), "npm", "pip", "gomod", "cargo",
# "maven", "docker". Add one `updates` block per ecosystem present in the repo.
#
# The "github-actions" block below applies to every project that uses GitHub
# Actions — keep it.
version: 2
updates:
  - package-ecosystem: "github-actions"
    directory: "/"
    schedule:
      interval: "weekly"

  # --- Replace this block with the project's actual ecosystem ---
  - package-ecosystem: "{{ECOSYSTEM}}" # e.g. nuget, npm, pip, gomod, cargo
    directory: "/"
    schedule:
      interval: "weekly"
    open-pull-requests-limit: 10
