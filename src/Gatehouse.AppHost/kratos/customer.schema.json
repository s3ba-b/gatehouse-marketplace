{
  "$id": "https://raw.githubusercontent.com/s3ba-b/gatehouse-marketplace/main/src/Gatehouse.AppHost/kratos/customer.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Customer",
  "description": "Retail buyer. Belongs to no vendor organization (GLOSSARY.md); org membership and roles are vendor-staff.schema.json's concern.",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "title": "E-Mail",
          "minLength": 3,
          "ory.sh/kratos": {
            "credentials": {
              "password": {
                "identifier": true
              }
            }
          }
        },
        "name": {
          "type": "object",
          "title": "Name",
          "description": "Optional retail profile — used for display and order/shipping details, not for sign-in.",
          "properties": {
            "first": {
              "type": "string",
              "title": "First name"
            },
            "last": {
              "type": "string",
              "title": "Last name"
            }
          }
        }
      },
      "required": ["email"],
      "additionalProperties": false
    }
  }
}
